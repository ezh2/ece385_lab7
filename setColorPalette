void setColorPalette (uint8_t color, uint8_t red, uint8_t green, uint8_t blue)
{
	//fill in this function to set the color palette entry <color> to <red>, <green>, <blue> 12-bit color


		//why int8? couldnt find int 4 in c
	// we know this is a list of 16 colors from 0 to 15 indexed,  the first parameter is the color index we are setting the rgb vals to 
	uint32_t colorWordAddress=0x800+(color/2);//get the word address of the register containing this color
    volatile uint32_t *registers=(volatile uint32_t *)hdmi_ctrl; //so that we start at hdmi_ctrl then move forward by 0x800 
    uint32_t val=registers[colorWordAddress];//read the old register val
    uint8_t part=color%2;//when even its the lower 16 bits when odd its the upper 16 bits

    if(part==0)// first 16 bits 
    {
    val=(val&0b11111111111111111111111111110000u);//this clears the old blue bits vals only and preserve teh rest
    val=val|(blue&0b1111u);//this sets the new blue val in bits 3:0
    val=(val&0b11111111111111111111111100001111u);//this clears the old green bits vals only and preserve teh rest
    val=val|((green&0b1111u)*16u);//this sets the new green val in the correct 7:4 bits position
    val=(val&0b11111111111111111111000011111111u);//this clears the old red bits vals only and preserve teh rest
    val=val|((red&0b1111u)*256u);//this sets the new red val in the correct 11:8 bits position
    }
    else //seconed 16 bits 
    {
    val=(val&0b11111111111100001111111111111111u);//this clears the old blue bits vals only and preserve teh rest
    val=val|((blue&0b1111u)*65536u);//this sets the new blue val in the correct 19:16 bits position
    val=(val&0b11111111000011111111111111111111u);//this clears the old green bits vals only and preserve teh rest
    val=val|((green&0b1111u)*1048576u);//this sets the new green val in the correct 23:20 bits position
    val=(val&0b11110000111111111111111111111111u);//this clears the old red bits vals only and preserve teh rest
    val=val|((red&0b1111u)*16777216u);//this sets the new red val in the correct 27:24 bits position
    }
    registers[colorWordAddress]=val;//write the updated val back to the hardware register

}
